#!/usr/bin/env bash
# omarchy-agents — one Super+A drop-down for all your AI agents, with a tab strip.
# https://github.com/<you>/omarchy-agent-switcher  (MIT)
#
#   omarchy-agents toggle            open/close the drop-down (last agent)
#   omarchy-agents show <name>       open, or slide to, an agent
#   omarchy-agents next|prev         cycle agents (tab order)
#   omarchy-agents direct <class> [--start-hidden]   per-agent shortcut
#   omarchy-agents hide | list | rules | setup [--yes] | doctor | hint on|off|toggle
set -u
VERSION=1.0.0
CFG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-agent-switcher
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-agent-switcher
CONF=${OMARCHY_AGENTS_CONF:-$CFG_HOME/omarchy-agent-switcher/agents.conf}
REGISTRY=$DATA/registry.conf
RULES=$CFG_HOME/hypr/agent-switcher.lua
PLUGIN_ID=io.github.paytonrogers.agent-switcher
SELF=$(readlink -f "$0")
WS=agents
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.npm-global/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"
mkdir -p "$STATE"

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf "%s" "${s%"${s##*[![:space:]]}"}"; }
d() { hyprctl dispatch "$1" >/dev/null 2>&1; }
die() { echo "omarchy-agents: $*" >&2; exit 1; }

# ---------- config ----------------------------------------------------------
declare -A S=( [toggle_key]="SUPER + A" [accent]="" [accent_inactive]="" [width]=0.62 [height]=0.82
  [top]=0.06 [slide_ms]=250 [opacity]="0.82 0.75" [rounding]=14 [border]=2 [dim]=true [start_hidden]="" [show_hint]=""
  [prev_key]="SUPER + ALT + LEFT" [next_key]="SUPER + ALT + RIGHT" )
names=(); classes=(); cmds=(); keys=(); icons=(); all_names=()
# Resolve the program a launch line runs (skipping wrappers/flags) and check it exists.
available() {
  local -a t; read -r -a t <<<"$1"; local x i=0
  while (( i < ${#t[@]} )); do
    x=${t[$i]}; x=${x/#\~/$HOME}; x=${x//\$HOME/$HOME}
    case $x in uwsm-app|app2unit|setsid|env|--|omarchy-launch-tui|omarchy-launch-or-focus-tui|omarchy-launch-webapp|-*|*=*) i=$((i+1)); continue ;; esac
    if [[ $x == flatpak ]]; then flatpak info "${t[-1]}" >/dev/null 2>&1; return; fi
    command -v "$x" >/dev/null 2>&1; return
  done; return 1
}
load_conf() {
  [[ -f $CONF ]] || return 0
  local line n c l k ic
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ $line == *"|"* ]]; then
      IFS='|' read -r n c l k ic <<<"$line"
      n=$(trim "$n"); c=$(trim "$c"); l=$(trim "$l"); [[ -z $n || -z $c || -z $l ]] && continue
      all_names+=("$n"); available "$l" || continue
      names+=("$n"); classes+=("$c"); cmds+=("$l"); keys+=("$(trim "${k:-}")"); icons+=("$(trim "${ic:-}")")
    elif [[ $line == *=* ]]; then
      local v; v=$(trim "${line#*=}"); v=$(trim "${v%%[[:space:]]#*}"); S[$(trim "${line%%=*}")]=$v
    fi
  done < "$CONF"
}
theme_color() { # theme_color <key> -> #RRGGBB from the active Omarchy theme
  local f=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml
  [[ -f $f ]] && sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" "$f" | head -1
}
accent() { local a=${S[accent]}; [[ -z $a ]] && a=$(theme_color accent); echo "${a:-#89B4FA}"; }
accent2() { local a=${S[accent_inactive]}; [[ -z $a ]] && a=$(theme_color selection); echo "${a:-#45475A}"; }

# ---------- rules (generated hypr include) ----------------------------------
gen_rules() {
  load_conf
  local re="" c i a=$(accent) b=$(accent2) w=${S[width]} h=${S[height]} t=${S[top]} x
  x=$(awk -v w="$w" 'BEGIN{printf "%.4f",(1-w)/2}')
  for c in "${classes[@]}"; do re+="${re:+|}$(sed 's/[.[\()*+?^$]/\\\\&/g' <<<"$c")"; done
  mkdir -p "$(dirname "$RULES")"
  {
    echo "-- Generated by omarchy-agents $VERSION from $CONF. Do not edit: run \`omarchy-agents rules\`."
    if [[ -n $re ]]; then
      echo "o.window(\"^($re)\$\", { workspace = \"special:$WS silent\", float = true, size = { \"(monitor_w*$w)\", \"(monitor_h*$h)\" }, move = { \"(monitor_w*$x)\", \"(monitor_h*$t)\" }, tag = \"-default-opacity\", opacity = \"${S[opacity]}\", rounding = ${S[rounding]}, border_size = ${S[border]}, border_color = \"rgb(${a#\#}) rgb(${b#\#})\" })"
    fi
    echo "local function ab(key, desc, cmd) pcall(hl.unbind, key); o.bind(key, desc, cmd) end"
    echo "ab(\"${S[toggle_key]}\", \"Agent switcher\", \"$SELF toggle\")"
    for i in "${!names[@]}"; do [[ -n ${keys[$i]} ]] && echo "ab(\"${keys[$i]}\", \"${names[$i]} (agent switcher)\", \"$SELF direct ${classes[$i]}\")"; done
    [[ -n ${S[start_hidden]} ]] && echo "o.launch_on_start(\"$SELF direct ${S[start_hidden]// /} --start-hidden\")"
    echo "hl.animation({ leaf = \"windowsMove\", enabled = true, speed = $(awk -v m="${S[slide_ms]}" 'BEGIN{printf "%.2f", m/100}'), bezier = \"easeOutQuint\" })  -- agent switch slide (slide_ms)"
    # Cycle keys exist only while the panel is open (omarchy-agents calls on()/off()).
    # Omarchy's own binds on these keys are put back on close.
    cat <<LUA
agent_switcher = agent_switcher or {}
local cycle = { { key = "${S[prev_key]}", cmd = "$SELF prev", desc = "Previous agent" }, { key = "${S[next_key]}", cmd = "$SELF next", desc = "Next agent" } }
local omarchy_default = {
  ["SUPER + ALT + LEFT"]  = { "Move window to group on left",  function() return hl.dsp.window.move({ into_group = "l" }) end },
  ["SUPER + ALT + RIGHT"] = { "Move window to group on right", function() return hl.dsp.window.move({ into_group = "r" }) end },
}
function agent_switcher.on()
  for _, c in ipairs(cycle) do pcall(hl.unbind, c.key); hl.bind(c.key, hl.dsp.exec_cmd(c.cmd), { description = c.desc }) end
end
function agent_switcher.off()
  for _, c in ipairs(cycle) do
    pcall(hl.unbind, c.key)
    local d = omarchy_default[c.key]
    if d then hl.bind(c.key, d[2](), { description = d[1] }) end
  end
end
LUA
  } > "$RULES.tmp" && mv "$RULES.tmp" "$RULES"
  echo "wrote $RULES"
  local k desc; for k in "${S[prev_key]}" "${S[next_key]}"; do
    desc=$(bind_desc "$k"); [[ -n $desc && $desc != "Move window to group on"* && $desc != *"agent"* ]] && \
      echo "warning: $k is bound to \"$desc\"; it is shadowed while the panel is open and NOT restored on close. Pick another prev_key/next_key." >&2
  done; return 0
}
bind_desc() { # description of an existing bind for "MODS + KEY"
  local mods=0 m key=${1##*+}; key=$(trim "$key")
  for m in $(tr '+' ' ' <<<"${1%+*}"); do case ${m^^} in SHIFT) mods=$((mods|1));; CTRL|CONTROL) mods=$((mods|4));; ALT) mods=$((mods|8));; SUPER|WIN|MOD4) mods=$((mods|64));; esac; done
  hyprctl binds -j 2>/dev/null | jq -r --argjson m $mods --arg k "${key^^}" 'first(.[]|select(.modmask==$m and (.key|ascii_upcase)==$k and .submap==""))|.description // empty'
}

# ---------- setup (agent detection) -----------------------------------------
detect() { # prints registry lines whose detection matches
  local line id n kind det c l ic
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    IFS='|' read -r id n kind det c l ic <<<"$line"; det=$(trim "$det")
    local how=${det%%:*} what=${det#*:} ok=1
    case $how in
      bin) command -v "$what" >/dev/null 2>&1 && ok=0 ;;
      desktop) for dd in ${XDG_DATA_HOME:-$HOME/.local/share} ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do for e in ${dd//:/ }; do [[ -f $e/applications/$what ]] && ok=0; done; done ;;
      flatpak) flatpak info "$what" >/dev/null 2>&1 && ok=0 ;;
    esac
    (( ok == 0 )) && echo "$line"
  done < "$REGISTRY"
}
agent_line() { # registry line -> agents.conf line
  local id n kind det c l ic p; IFS='|' read -r id n kind det c l ic <<<"$1"
  id=$(trim "$id"); n=$(trim "$n"); kind=$(trim "$kind"); det=$(trim "$det"); c=$(trim "$c"); l=$(trim "$l"); ic=$(trim "$ic")
  if [[ -z $l && $kind == tui ]]; then p=$(command -v "${det#*:}"); l="omarchy-launch-tui --app-id=$c ${p/#$HOME/\$HOME}"; fi
  local k=""; [[ -f $CONF ]] && k=$(awk -F'|' -v c="$c" '$2 ~ "^[ \t]*"c"[ \t]*$" {gsub(/^[ \t]+|[ \t]+$/,"",$4); print $4; exit}' "$CONF")
  printf '%-14s | %-26s | %s | %s | %s\n' "$n" "$c" "$l" "$k" "$ic"
}
have_gum() { [[ -z ${OMARCHY_AGENTS_NO_GUM:-} ]] && command -v gum >/dev/null; }   # OMARCHY_AGENTS_NO_GUM=1 forces plain prompts
setup() {
  [[ -f $REGISTRY ]] || die "registry not found ($REGISTRY); run install.sh"
  local yes=0; [[ ${1:-} == --yes || ${1:-} == --detect || ! -t 0 ]] && yes=1
  mapfile -t found < <(detect)
  (( ${#found[@]} )) || die "no known agents detected. Add one by hand to $CONF"
  local -a labels=() chosen=(); local f
  for f in "${found[@]}"; do labels+=("$(trim "$(cut -d'|' -f2 <<<"$f")")"); done
  if (( yes )); then chosen=("${found[@]}")
  else
    echo "Detected agents:"; local sel
    if have_gum; then
      mapfile -t sel < <(gum choose --no-limit --header "Agents for the Super+A switcher (space toggles)" --selected="$(IFS=,; echo "${labels[*]}")" "${labels[@]}")
    else
      local i a; for i in "${!labels[@]}"; do read -r -p "  include ${labels[$i]}? [Y/n] " a; [[ $a =~ ^[Nn] ]] || sel+=("${labels[$i]}"); done
    fi
    (( ${#sel[@]} )) || die "nothing selected"
    local -a ordered=("${sel[@]}") ord
    if (( ${#sel[@]} > 1 )); then
      local i; for i in "${!sel[@]}"; do echo "  $((i+1)). ${sel[$i]}"; done
      local o; if have_gum; then o=$(gum input --placeholder "tab order, e.g. 2 1 3 (enter keeps this order)"); else read -r -p "Tab order (e.g. 2 1 3, enter keeps): " o; fi
      if [[ -n $o ]]; then ordered=(); for i in $o; do [[ $i =~ ^[0-9]+$ ]] && (( i>=1 && i<=${#sel[@]} )) && ordered+=("${sel[$((i-1))]}"); done; fi
    fi
    for a in "${ordered[@]}"; do for i in "${!labels[@]}"; do [[ ${labels[$i]} == "$a" ]] && chosen+=("${found[$i]}"); done; done
  fi
  mkdir -p "$(dirname "$CONF")"; [[ -f $CONF ]] && cp "$CONF" "$CONF.bak"
  {
    if [[ -f $CONF ]]; then grep -v '|' "$CONF" | grep -v '^# Agents (generated' ; else sed '/|/d; /^# Agents (generated/d' "$DATA/agents.conf.default"; fi
    echo "# Agents (generated by \`omarchy-agents setup\`): name | window class | launch | direct key | icon"
    for f in "${chosen[@]}"; do agent_line "$f"; done
  } > "$CONF.new" && mv "$CONF.new" "$CONF"
  echo "wrote $CONF (${#chosen[@]} agents)"; gen_rules; hyprctl reload >/dev/null 2>&1 || true
}

# ---------- runtime ---------------------------------------------------------
# Speed matters here: every hyprctl/jq spawn is ~10-30 ms on a laptop, so state
# is read once (monitors + clients + cursor, in parallel) and all window changes
# for one action go to Hyprland as a single Lua chunk via `hyprctl eval`.
runtime_init() {
  exec 9>"$STATE/lock"; flock -w 3 9 || exit 0
  local tmp=$STATE/snap.$$
  hyprctl -j monitors > "$tmp.m" & hyprctl -j clients > "$tmp.c" & hyprctl cursorpos > "$tmp.p" & wait
  load_conf; N=${#names[@]}; (( N )) || { rm -f "$tmp".*; notify-send "Agent switcher" "No agents available — run omarchy-agents setup" 2>/dev/null; exit 1; }
  last=$(cat "$STATE/last" 2>/dev/null || echo "${names[0]}")
  CURSOR=$(<"$tmp.p")
  # One jq pass: focused monitor geometry, visibility, and "class addr ws w h x" per agent window.
  local cls; cls=$(printf '%s\n' "${classes[@]}" | jq -R . | jq -sc .)
  local out; out=$(jq -r -n --slurpfile m "$tmp.m" --slurpfile c "$tmp.c" --argjson cls "$cls" --arg ws "special:$WS" '
    ($m[0] | first(.[]|select(.focused))) as $f
    | (if ($f.transform % 2)==1 then [$f.height,$f.width] else [$f.width,$f.height] end) as $wh
    | "\($f.name) \($f.x) \($f.y) \(($wh[0]/$f.scale)|floor) \(($wh[1]/$f.scale)|floor) \(if $f.specialWorkspace.name==$ws then 1 else 0 end)",
      ($cls[] as $k | first($c[0][] | select(.class==$k)) // null | if . then "\(.class) \(.address) \(.workspace.name) \(.size[0]) \(.size[1]) \(.at[0])" else empty end)')
  rm -f "$tmp".*
  read -r MON MX MY MW MH VIS <<<"$(head -1 <<<"$out")"
  declare -gA ADDR=() WSN=() WW=() WH=() WX=()
  local c a w x y z; while read -r c a w x y z; do [[ -n $c ]] || continue; ADDR[$c]=$a; WSN[$c]=$w; WW[$c]=$x; WH[$c]=$y; WX[$c]=$z; done <<<"$(tail -n +2 <<<"$out")"
  local fw ft fh; read -r fw ft fh < <(awk -v a="${S[width]}" -v b="${S[top]}" -v c="${S[height]}" 'BEGIN{printf "%d %d %d", a*100+.5, b*100+.5, c*100+.5}')
  SX=$(( MX + MW * (100 - fw) / 200 )); SY=$(( MY + MH * ft / 100 ))
  PW=$(( MW * fw / 100 )); PH=$(( MH * fh / 100 ))
  read -r OA OI <<<"${S[opacity]}"; OI=${OI:-$OA}
  LUA=""
}
q() { LUA+="hl.dispatch($1) "; }                      # queue a dispatcher
flush() { [[ -n $LUA ]] && hyprctl eval "$LUA" >/dev/null 2>&1; LUA=""; }
idx_of() { local i; for i in "${!names[@]}"; do [[ ${names[$i]} == "$1" || ${classes[$i]} == "$1" ]] && { echo $i; return; }; done; [[ $1 =~ ^[0-9]+$ ]] && (( $1 < N )) && { echo $1; return; }; echo 0; }
visible() { (( VIS == 1 )); }
addr_of() { echo "${ADDR[${classes[$1]}]:-}"; }
prop() { q "hl.dsp.window.set_prop({ window = 'address:$1', prop = '$2', value = '$3' })"; }
move() { q "hl.dsp.window.move({ window = 'address:$1', x = $2, y = $SY })"; }
teleport() { prop "$1" no_anim 1; move "$1" "$2"; prop "$1" no_anim 0; }
left_of()  { echo $(( MX - $1 - 40 )); }   # just past the focused monitor's edges
right_of() { echo $(( MX + MW + 40 )); }
park_x() { local c=${classes[$1]}; (( $1 < $2 )) && left_of "${WW[$c]:-$PW}" || right_of; }
keep_cursor() { q "hl.dsp.cursor.move({ x = ${CURSOR%%,*}, y = ${CURSOR##*, } })"; }   # hl.dsp.focus warps the pointer
resolve_cmd() { # make the launch line independent of the caller's PATH:
  # uwsm-app/systemd don't see mise/npm/~/.local/bin, so turn the program into an absolute path.
  local -a t; read -r -a t <<<"$1"; local i x out=() done=0
  for i in "${!t[@]}"; do x=${t[$i]}
    if (( !done )); then case $x in uwsm-app|app2unit|setsid|env|--|omarchy-launch-tui|omarchy-launch-or-focus-tui|-*|*=*) out+=("$x"); continue ;; esac
      x=${x/#\~/$HOME}; x=${x//\$HOME/$HOME}; [[ $x != */* ]] && x=$(command -v "$x" || echo "$x"); done=1; fi
    out+=("$x"); done
  echo "${out[*]}"
}
launch() { # launch <idx> in the background (never blocks); window rules put it in special:agents at the slot
  local i=$1
  [[ -f $STATE/launch.${classes[$i]} ]] && (( $(date +%s) - $(stat -c %Y "$STATE/launch.${classes[$i]}") < 30 )) && return 0
  touch "$STATE/launch.${classes[$i]}"
  ( cd "$HOME" && exec setsid bash -c "$(resolve_cmd "${cmds[$i]}")" ) >/dev/null 2>&1 9>&- &
}
await_window() { # background: when agent <idx> maps, focus + dim it if it's still the active tab
  local i=$1 c=${classes[$1]} n=${names[$1]}
  ( for _ in $(seq 150); do
      a=$(hyprctl -j clients | jq -r --arg c "$c" 'first(.[]|select(.class==$c))|.address // empty'); [[ -n $a ]] && break; sleep 0.2; done
    rm -f "$STATE/launch.$c"; [[ -n $a && $(cat "$STATE/last" 2>/dev/null) == "$n" ]] || exit 0
    p=$(hyprctl cursorpos); l="hl.dispatch(hl.dsp.focus({ window = 'address:$a' })) hl.dispatch(hl.dsp.cursor.move({ x = ${p%%,*}, y = ${p##*, } })) "
    [[ ${S[dim]} == true ]] && l+="hl.dispatch(hl.dsp.window.set_prop({ window = 'address:$a', prop = 'dim_around', value = '1' })) "
    hyprctl eval "$l" >/dev/null 2>&1 ) 9>&- >/dev/null 2>&1 &
}
starting() { notify-send -a "Agent switcher" -u low -t 2500 "Starting ${names[$1]}…" 2>/dev/null & }
ensure() { # ensure <idx>: 0 = window exists (queued fixes), 2 = launching in background
  local i=$1 c=${classes[$1]} a
  a=${ADDR[$c]:-}
  [[ -z $a ]] && { launch $i; return 2; }
  [[ ${WSN[$c]} != "special:$WS" ]] && { q "hl.dsp.window.move({ workspace = 'special:$WS', follow = false, window = 'address:$a' })"; WSN[$c]=special:$WS; }
  if (( ${WW[$c]:-0} != PW || ${WH[$c]:-0} != PH )); then q "hl.dsp.window.resize({ window = 'address:$a', x = $PW, y = $PH })"; WW[$c]=$PW; WH[$c]=$PH; fi
  return 0
}
dim_on() { [[ ${S[dim]} == true ]] && prop "$1" dim_around 1; return 0; }
payload() {
  local i ic out="["; for i in "${!names[@]}"; do
    ic=${icons[$i]}; if [[ -z $ic ]]; then :; elif [[ $ic == /* ]]; then ic="file://$ic"
    elif [[ -f $DATA/icons/$ic.svg ]]; then ic="file://$DATA/icons/$ic.svg"; else ic="image://icon/$ic"; fi
    out+="$(jq -cn --arg n "${names[$i]}" --arg i "$ic" '{name:$n,icon:$i}'),"; done; out="${out%,}]"
  jq -cn --argjson a "$out" --arg s "${names[$1]}" --arg acc "$(accent)" --arg bin "$SELF" --arg mon "$MON" \
    --argjson top "$(( SY - MY + PH + 10 ))" --arg key "${S[toggle_key]}" --arg pk "${S[prev_key]}" --arg nk "${S[next_key]}" \
    --argjson hint "$(show_hint && echo true || echo false)" \
    '{agents:$a,active:$s,accent:$acc,bin:$bin,monitor:$mon,top:$top,toggleKey:$key,prevKey:$pk,nextKey:$nk,hint:$hint}'
}
show_hint() { local v=${S[show_hint]:-${S[hint]:-true}}; [[ $v == true || $v == on || $v == 1 ]]; }
# Strip updates go to the shell in the background so they never delay the slide.
strip_show() { ( timeout 2 omarchy-shell -q shell summon "$PLUGIN_ID" "$(payload $1)" ) >/dev/null 2>&1 9>&- & }
strip_hide() { ( timeout 2 omarchy-shell -q agentswitcher hide ) >/dev/null 2>&1 9>&- & }

open_idx() { # hidden -> visible; the special workspace slides up (slidevert)
  local i=$1 a j b pending=0
  ensure $i || pending=1; a=$(addr_of $i)
  for j in "${!names[@]}"; do (( j == i )) && continue; b=$(addr_of $j); [[ -n $b ]] || continue
    ensure $j; prop "$b" opacity 0; prop "$b" opacity_inactive 0; prop "$b" dim_around 0; done   # hidden workspaces clamp off-screen windows
  [[ -n $a ]] && { teleport "$a" "$SX"; dim_on "$a"; }
  q "hl.dsp.workspace.toggle_special('$WS')"
  for j in "${!names[@]}"; do (( j == i )) && continue; b=$(addr_of $j); [[ -n $b ]] || continue
    teleport "$b" "$(park_x $j $i)"; prop "$b" opacity "$OA"; prop "$b" opacity_inactive "$OI"; done
  [[ -n $a ]] && { q "hl.dsp.focus({ window = 'address:$a' })"; keep_cursor; }
  LUA+="if agent_switcher then agent_switcher.on() end "
  flush
  echo "${names[$i]}" > "$STATE/last"; strip_show $i
  (( pending )) && { starting $i; await_window $i; }
}
switch_to() { # visible -> horizontal slide in tab order, one eval
  local i=$1 cur a b c from out pending=0
  cur=$(idx_of "$last"); (( i == cur )) && { strip_show $i; return; }
  ensure $i || pending=1; a=$(addr_of $i); b=$(addr_of $cur); c=${classes[$i]}
  # Incoming normally already waits on the correct side (pre-parked); only teleport if not.
  (( i > cur )) && from=$(right_of) || from=$(left_of "${WW[$c]:-$PW}")
  [[ -n $a && ${WX[$c]:-x} != "$from" ]] && teleport "$a" "$from"
  if [[ -n $b ]]; then
    (( i > cur )) && out=$(left_of "${WW[${classes[$cur]}]:-$PW}") || out=$(right_of)
    prop "$b" dim_around 0; move "$b" "$out"
  fi
  [[ -n $a ]] && { move "$a" "$SX"; dim_on "$a"; q "hl.dsp.focus({ window = 'address:$a' })"; keep_cursor; }
  # other (non-adjacent) agents: make sure they wait on the correct side
  local j x; for j in "${!names[@]}"; do (( j == i || j == cur )) && continue; x=$(addr_of $j); [[ -n $x ]] || continue
    [[ ${WX[${classes[$j]}]:-} != "$(park_x $j $i)" ]] && teleport "$x" "$(park_x $j $i)"; done
  flush
  echo "${names[$i]}" > "$STATE/last"; strip_show $i
  (( pending )) && { starting $i; await_window $i; }   # new window appears in the slot (rules), no blocking
  return 0
}
hide_all() {
  visible && q "hl.dsp.workspace.toggle_special('$WS')"
  LUA+="if agent_switcher then agent_switcher.off() end "; flush; strip_hide
}
cycle_keys() { hyprctl eval "if agent_switcher then agent_switcher.$1() end" >/dev/null 2>&1; }
set_hint() { # hint on|off|toggle: persist show_hint in agents.conf and update the strip
  local v; case ${1:-toggle} in on|true) v=true ;; off|false) v=false ;; toggle) show_hint && v=false || v=true ;; *) die "usage: hint on|off|toggle" ;; esac
  if grep -qE '^[[:space:]]*(show_hint|hint)[[:space:]]*=' "$CONF"; then
    sed -i -E "s/^([[:space:]]*)(show_hint|hint)([[:space:]]*)=[[:space:]]*[A-Za-z0-9]+/\1show_hint\3= $v/" "$CONF"
  else sed -i "0,/^toggle_key/s//show_hint = $v\n&/" "$CONF"; grep -q '^show_hint' "$CONF" || echo "show_hint = $v" >> "$CONF"; fi
  S[show_hint]=$v; echo "hint $( [[ $v == true ]] && echo on || echo off)"
}

doctor() {
  load_conf; echo "omarchy-agents $VERSION"; echo "config:   $CONF $([[ -f $CONF ]] || echo '(missing)')"; echo "rules:    $RULES $([[ -f $RULES ]] || echo '(missing)')"
  echo "plugin:   $(omarchy-shell agentswitcher ping 2>/dev/null || echo 'not loaded (opens on first use)')"
  local n; for n in "${all_names[@]}"; do [[ " ${names[*]} " == *" $n "* ]] && echo "  ok      $n" || echo "  missing $n (tab skipped)"; done
  echo "hyprland config errors:"; hyprctl configerrors
}

cmd=${1:-toggle}
case $cmd in
  rules) gen_rules; exit ;;
  setup) shift; setup "$@"; exit ;;
  doctor) doctor; exit ;;
  list) load_conf; printf '%s\n' "${names[@]}"; exit ;;
  version|--version) echo "$VERSION"; exit ;;
  hint) ( load_conf; set_hint "${2:-toggle}" ) || exit 1
        if [[ $(hyprctl -j monitors | jq -r 'first(.[]|select(.focused)).specialWorkspace.name') == "special:$WS" ]]; then
          runtime_init; strip_show "$(idx_of "$last")"; wait; fi; exit ;;
esac
runtime_init
case $cmd in
  toggle) if visible; then hide_all; else open_idx "$(idx_of "$last")"; fi ;;
  show)   i=$(idx_of "${2:-$last}"); if visible; then switch_to $i; else open_idx $i; fi ;;
  next|prev) visible || { cycle_keys off; strip_hide; wait; exit 0; }   # panel was closed some other way
          i=$(idx_of "$last"); [[ $cmd == next ]] && i=$(( (i+1)%N )) || i=$(( (i-1+N)%N )); switch_to $i ;;
  direct) i=$(idx_of "${2:-}")
          if [[ ${3:-} == --start-hidden ]]; then for c in ${2//,/ }; do ensure "$(idx_of "$c")"; done; flush
          elif visible && [[ ${names[$i]} == "$last" ]]; then hide_all
          elif visible; then switch_to $i
          else open_idx $i; fi ;;
  hide)   hide_all ;;
  *) sed -n '5,10p' "$SELF" >&2; exit 2 ;;
esac
