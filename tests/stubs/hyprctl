#!/usr/bin/env bash
# Fake hyprctl for tests: serves JSON from $FAKE and records mutating calls to $FAKE/calls.
j=0; [[ ${1:-} == -j ]] && { j=1; shift; }
[[ ${2:-} == -j ]] && j=1
case ${1:-} in
  monitors) cat "$FAKE/monitors.json" ;;
  clients) cat "$FAKE/clients.json" ;;
  activewindow) cat "$FAKE/activewindow.json" 2>/dev/null || echo '{}' ;;
  cursorpos) cat "$FAKE/cursor" 2>/dev/null || echo "100, 200" ;;
  binds) cat "$FAKE/binds.json" 2>/dev/null || echo '[]' ;;
  configerrors) echo "" ;;
  version) echo "Hyprland 0.56.2 (fake)" ;;
  eval|dispatch|reload|animations) printf '%s\t%s\n' "$1" "${*:2}" >> "$FAKE/calls"; [[ $1 == animations ]] && echo '[[]]' || echo ok ;;
  *) printf 'other\t%s\n' "$*" >> "$FAKE/calls" ;;
esac
: "$j"
