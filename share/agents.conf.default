# omarchy-agent-switcher config. Run `omarchy-agents rules` (or `setup`) after editing.
# ---- settings (all optional) ----
toggle_key = SUPER + A
# accent = #9B7BD4          # strip + border colour; empty = active Omarchy theme accent
# accent_inactive = #5E4A85 # unfocused border; empty = theme selection colour
width = auto                # auto | 0.62 | 62% | 1200px (logical px of the focused monitor)
height = auto               # auto fills below the bar, leaving room for the strip
top = auto                  # gap above the panel
max_width = 1600            # clamp; min_width = 640
slide_ms = 250              # agent-switch slide duration; 0 = off
override_slide_animation = true  # false = keep your own Hyprland windowsMove animation
opacity = 0.82 0.75         # active inactive
rounding = 14
dim = true                  # dim the desktop behind the active agent
show_hint = true           # "? shortcuts" button on the strip (runtime: omarchy-agents hint on/off/toggle)
prev_key = SUPER + ALT + LEFT    # cycle agents; bound ONLY while the panel is open
next_key = SUPER + ALT + RIGHT
# shortcuts_key = SUPER + SLASH   # optional global bind for the cheat sheet (default unbound)
# start_hidden = grok-bot  # comma list of window classes to launch hidden at login
# ---- agents: name | window class | launch | direct key (optional) | icon (optional) ----
# Agents whose program isn't installed are skipped automatically.
Grok Bot   | grok-bot              | uwsm-app -- grok-bot | SUPER + SHIFT + A | grok-bot
Grok Build | org.omarchy.grokbuild | omarchy-launch-tui --app-id=org.omarchy.grokbuild grok | SUPER + ALT + A | grok
# Claude Code | org.omarchy.agent.claude | omarchy-launch-tui --app-id=org.omarchy.agent.claude claude | | claude
# Codex       | org.omarchy.agent.codex  | omarchy-launch-tui --app-id=org.omarchy.agent.codex codex   | | codex
