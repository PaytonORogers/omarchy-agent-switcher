#!/usr/bin/python3 -I
"""Run packaged Omarchy collectors, then this plugin's Grok / Grok Bot / Hermes collectors.

Each collector prints one JSON record on stdout. This process writes those
bytes through an exclusive temporary in the usage directory.
"""

from __future__ import annotations

import os
import re
import stat
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
MAX_RECORD = 262144
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
COLLECTORS = ("grok", "grok-bot", "hermes")
PACKAGED = "/usr/bin/omarchy-agent-usage-update"
TIMEOUT = 45


def fail(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def open_dir_chain(parts: list[str]) -> int:
    home = os.path.expanduser("~")
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for name in parts:
            if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or name in (".", ".."):
                raise PermissionError(name)
            try:
                nfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            except FileNotFoundError:
                os.mkdir(name, 0o700, dir_fd=fd)
                nfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
                raise PermissionError(name)
        st = os.fstat(fd)
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd)
        raise


def write_atomic(dirfd: int, name: str, data: bytes) -> None:
    import secrets

    tmp = f".{name}.{secrets.token_hex(8)}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dirfd)
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            n = os.write(fd, view)
            view = view[n:]
        os.fsync(fd)
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def run_capped(argv: list[str]) -> tuple[int, bytes]:
    import select

    proc = subprocess.Popen(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    assert proc.stdout is not None and proc.stderr is not None
    os.set_blocking(proc.stdout.fileno(), False)
    os.set_blocking(proc.stderr.fileno(), False)
    deadline = time.monotonic() + TIMEOUT
    out = b""
    err = b""

    def stop(sig: int) -> None:
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            pass

    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            stop(15)
            time.sleep(0.2)
            stop(9)
            proc.wait()
            return 124, out
        if len(out) > MAX_RECORD or len(err) > 4096:
            stop(15)
            time.sleep(0.2)
            stop(9)
            proc.wait()
            return 1, out
        ready, _, _ = select.select([proc.stdout, proc.stderr], [], [], min(0.2, remaining))
        if proc.stdout in ready:
            chunk = proc.stdout.read(4096) or b""
            out += chunk
        if proc.stderr in ready:
            chunk = proc.stderr.read(1024) or b""
            err += chunk
        if proc.poll() is not None:
            out += proc.stdout.read(MAX_RECORD + 1) or b""
            err += proc.stderr.read(4096) or b""
            break
    if err.strip():
        sys.stderr.buffer.write(err[:2048] + b"\n")
    return proc.returncode or 0, out


def wanted(agent: str, except_ids: set[str], only: list[str]) -> bool:
    if agent in except_ids:
        return False
    if not only:
        return True
    return agent in only


def main(argv: list[str]) -> int:
    flags: list[str] = []
    except_ids: set[str] = set()
    only: list[str] = []
    args = argv[1:]
    i = 0
    while i < len(args):
        if args[i] in ("--force", "--limits-only"):
            flags.append(args[i])
            i += 1
        elif args[i] == "--except" and i + 1 < len(args):
            except_ids.add(args[i + 1])
            i += 2
        elif ID_RE.fullmatch(args[i]):
            only.append(args[i])
            i += 1
        else:
            fail("unexpected argument", 2)
    status = 0
    if os.path.isfile(PACKAGED) and os.access(PACKAGED, os.X_OK):
        code, _ = run_capped([PACKAGED] + flags + only)
        if code != 0:
            status = 1
    dirfd = open_dir_chain([".local", "state", "omarchy", "agents", "usage"])
    try:
        for agent in COLLECTORS:
            if not wanted(agent, except_ids, only):
                continue
            collector = os.path.join(HERE, "collect-" + agent)
            if not os.path.isfile(collector) or not os.access(collector, os.X_OK):
                continue
            code, raw = run_capped(["/usr/bin/python3", "-I", "-S", collector] + flags)
            if code != 0 or not raw.strip():
                print(f"refresh: {agent} collector failed", file=sys.stderr)
                status = 1
                continue
            if len(raw) > MAX_RECORD:
                print(f"refresh: {agent} record too large", file=sys.stderr)
                status = 1
                continue
            try:
                import json

                parsed = json.loads(raw.decode("utf-8"))
            except Exception:
                print(f"refresh: {agent} invalid json", file=sys.stderr)
                status = 1
                continue
            if not isinstance(parsed, dict) or parsed.get("id") != agent:
                print(f"refresh: {agent} bad record", file=sys.stderr)
                status = 1
                continue
            ready = parsed.get("ready") is True
            limits = parsed.get("limits") if isinstance(parsed.get("limits"), list) else []
            if agent == "grok-bot" and not ready and len(limits) == 0:
                try:
                    os.unlink(agent + ".json", dir_fd=dirfd)
                except FileNotFoundError:
                    pass
                continue
            write_atomic(dirfd, agent + ".json", raw if raw.endswith(b"\n") else raw + b"\n")
    finally:
        os.close(dirfd)
    return status


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
