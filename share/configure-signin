#!/usr/bin/env python3
"""One GUI-owned sign-in session. JSON lines out; open/check/confirm/cancel in."""
import fcntl
import json
import os
from pathlib import Path
import select
import signal
import subprocess
import sys


class Session:
    def __init__(self, binary, name):
        self.binary, self.name = binary, name
        self.state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'omarchy-agent-switcher'
        self.state.mkdir(parents=True, exist_ok=True)
        self.marker = self.state / 'setup-login'
        self.owner = os.getppid()
        self.prepared = False
        self.result = {}
        self.lock = None

    def call(self, *args, timeout=35):
        process = subprocess.Popen([self.binary, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
        try:
            stdout, stderr = process.communicate(timeout=timeout)
            return subprocess.CompletedProcess(process.args, process.returncode, stdout, stderr)
        except BaseException:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.communicate(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
            raise

    def emit(self, state, message='', **fields):
        print(json.dumps(dict(self.result, state=state, message=message, **fields)), flush=True)

    def check(self):
        checked = self.call('auth', self.name)
        if checked.returncode:
            raise RuntimeError(checked.stderr.strip() or 'Cannot check this agent.')
        self.result = json.loads(checked.stdout)
        self.result.pop('message', None)
        self.emit(self.result['state'])
        return self.result['state']

    def prepare(self):
        if self.prepared:
            return
        self.lock = open(self.state / 'signin.lock', 'w')
        try:
            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another agent is signing in. Finish or cancel it first.')
        self.call('hide')
        self.marker.write_text(f"{os.getpid()} {self.result['class']}\n")
        self.prepared = True
        rules = self.call('rules', '--reload')
        errors = subprocess.run(['hyprctl', 'configerrors'], capture_output=True, text=True, timeout=5)
        if rules.returncode or errors.returncode or errors.stdout.strip():
            raise RuntimeError('Could not prepare the normal sign-in workspace.')

    def open_window(self):
        self.prepare()
        monitors = subprocess.run(['hyprctl', '-j', 'monitors'], capture_output=True, text=True, check=True, timeout=5)
        workspace = next(m for m in json.loads(monitors.stdout) if m.get('focused'))['activeWorkspace']['id']
        self.emit('opening', 'Opening the agent on your normal workspace…')
        result = self.call('login-window', self.name, str(workspace))
        if result.returncode:
            self.emit('failed', result.stderr.strip() or 'The agent window did not appear. Retry or cancel.')
        else:
            self.emit('awaiting_login', 'Finish signing in in the agent window, then choose Check again. You may close that window normally.')

    def commit(self):
        result = self.call('enable', self.name)
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or 'Could not add the agent.')
        self.emit('added', 'Agent added.')

    def cleanup(self):
        if self.prepared:
            try:
                if self.marker.read_text().split()[0] == str(os.getpid()):
                    self.marker.unlink(missing_ok=True)
                    self.call('rules', '--reload')
            except (OSError, IndexError):
                pass
        if self.lock:
            self.lock.close()

    def run(self):
        try:
            if self.check() == 'verified':
                self.commit()
                return
            while os.getppid() == self.owner:
                if not select.select([sys.stdin], [], [], 1)[0]:
                    continue
                command = sys.stdin.readline()
                if not command or command.strip() == 'cancel':
                    return
                command = command.strip()
                if command == 'open':
                    self.open_window()
                elif command == 'check':
                    if self.check() == 'verified':
                        self.commit()
                        return
                elif command == 'confirm':
                    # A negative supported check cannot be overridden by manual confirmation.
                    if self.check() == 'confirmation_needed':
                        self.commit()
                        return
        except (RuntimeError, OSError, ValueError, subprocess.SubprocessError, StopIteration, KeyError) as error:
            self.emit('failed', str(error))
        finally:
            self.cleanup()


def interrupted(_signal, _frame):
    raise SystemExit(0)


if __name__ == '__main__':
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, interrupted)
    Session(sys.argv[1], sys.argv[2]).run()
